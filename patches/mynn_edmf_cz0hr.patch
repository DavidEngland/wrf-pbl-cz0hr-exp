+!===================================================================
+! SUBROUTINE: cz0hr_regularize_ri
+! Purpose: Upstream Curvature-Aware Zero-Offset Hyperbolic Regularization
+!          (C-Z0HR) of the gradient Richardson number profile BEFORE it is
+!          consumed by the MYNN stability closures. Maps the raw profile
+!          ri -> ri_reg using the grid cell thickness (dz) and the profile
+!          curvature (d2Ri/dz2). Leaves the Sm/Sh closure algebra 100%
+!          unmodified. In-place on the ri array.
+!===================================================================
+  PURE SUBROUTINE cz0hr_regularize_ri(kts, kte, dz, ri)
+    IMPLICIT NONE
+
+    ! Input / Output Arguments
+    INTEGER, INTENT(IN) :: kts, kte
+    REAL(kind_phys), INTENT(IN),    DIMENSION(kts:kte) :: dz  ! layer thickness at mass levels [m]
+    REAL(kind_phys), INTENT(INOUT), DIMENSION(kts:kte) :: ri  ! gradient Richardson number (wall levels)
+
+    ! Local Scalars
+    INTEGER       :: k, n_levels
+    REAL(kind_phys) :: ri_zz, c_scale, x, phi_eps, ratio
+    REAL(kind_phys) :: dz_up, dz_dn, d_ri_up, d_ri_dn
+    REAL(kind_phys), DIMENSION(kts:kte) :: ri_raw
+
+    n_levels = kte - kts + 1
+
+    ! Enforce N_z >= 3 stencil gate: sparse columns pass through unmodified
+    IF (n_levels < 3) RETURN
+
+    ri_raw(kts:kte) = ri(kts:kte)
+
+    ! Boundary levels preserved for 1-sided stencil compatibility
+    ri(kts) = ri_raw(kts)
+    ri(kte) = ri_raw(kte)
+
+    ! Interior column loop
+    DO k = kts + 1, kte - 1
+       ! ri is defined on the walls (interfaces); wall k sits between mass
+       ! levels k-1 and k, so the adjacent cell thicknesses are dz(k-1) below
+       ! and dz(k) above.
+       dz_dn = dz(k-1)
+       dz_up = dz(k)
+
+       ! 1. Second-order central spatial derivative of Ri_g (d2Ri/dz2)
+       d_ri_dn = (ri_raw(k)   - ri_raw(k-1)) / dz_dn
+       d_ri_up = (ri_raw(k+1) - ri_raw(k))   / dz_up
+       ri_zz   = 2.0_kind_phys * (d_ri_up - d_ri_dn) / (dz_up + dz_dn)
+
+       ! 2. Grid-resolved spatial curvature metric C(z, dz)
+       c_scale = 0.5_kind_phys * ABS(ri_zz) * (dz_dn**2) + cz0hr_eps_c * cz0hr_ric
+
+       ! 3. C^inf hyperbolic distance metric Phi_eps(x)
+       x       = ri_raw(k) - cz0hr_ric
+       phi_eps = SQRT(x**2 + cz0hr_eps**2)
+
+       ! 4. Upstream regularized Richardson number mapping
+       ratio = (phi_eps + c_scale) / (phi_eps + (1.0_kind_phys + cz0hr_alpha) * c_scale)
+       ri(k) = cz0hr_ric + x * ratio
+    END DO
+
+  END SUBROUTINE cz0hr_regularize_ri
+
 END MODULE module_bl_mynnedmf
